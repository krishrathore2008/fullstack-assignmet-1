<h2>Student Registration Form</h2>

<table class="form">

    <tr><td>Full Name *</td><td><input type="text"></td></tr>

    <tr><td>Email *</td><td><input type="email"></td></tr>

    <tr><td>Phone *</td><td><input type="text"></td></tr>

    <tr><td>College</td><td><input type="text"></td></tr>

    <tr>
        <td>Year</td>
        <td>
            <input type="radio" name="year">1st Year
            <input type="radio" name="year">2nd Year
            <input type="radio" name="year">3rd Year
            <input type="radio" name="year">4th Year
        </td>
    </tr>

    <tr>
        <td>Select Competition *</td>
        <td>
            <select>
                <option>-- Select Competition --</option>
                <option>Coding Challenge</option>
                <option>Hackathon</option>
                <option>AI Quiz</option>
                <option>Robotics</option>
            </select>
        </td>
    </tr>

    <tr>
        <td>Skills</td>
        <td>
            <input type="checkbox">HTML
            <input type="checkbox">CSS
            <input type="checkbox">JavaScript
            <input type="checkbox">Python
            <input type="checkbox">Java
            <input type="checkbox">AI/ML
        </td>
    </tr>

    <tr>
        <td>Participation Type</td>
        <td>
            <input type="radio" name="type">Individual
            <input type="radio" name="type">Team
        </td>
    </tr>

    <tr>
        <td>Team Members</td>
        <td>
            <input type="text">
        </td>
    </tr>

    <tr>
        <td>Address</td>
        <td><textarea></textarea></td>
    </tr>

    <tr>
        <td>Upload Student ID</td>
        <td><input type="file"></td>
    </tr>

    <tr>
        <td></td>
        <td>
            <input type="submit" value="Register">
            <input type="reset" value="Reset">
        </td>
    </tr>

</table>

