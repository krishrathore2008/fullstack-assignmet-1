<!DOCTYPE html>
<html>
<head>
    <title>TechFest 2026</title>

    <style>
        body{
            font-family: Times New Roman;
            margin:20px;
            border:1px solid gray;
            padding:15px;
        }

        h1,h2{
            text-align:center;
        }

        .sub{
            text-align:center;
        }

        nav{
            text-align:center;
            margin:10px;
        }

        nav a{
            margin:0 8px;
        }

        .about{
            display:flex;
            justify-content:space-between;
        }

        .left{
            width:60%;
        }

        .right{
            width:30%;
            text-align:center;
        }

        .right img{
            width:250px;
        }

        table{
            width:90%;
            margin:auto;
            border-collapse:collapse;
        }

        table,th,td{
            border:1px solid black;
        }

        th,td{
            padding:6px;
            text-align:center;
        }

        .form td{
            text-align:left;
        }

        input,select,textarea{
            width:95%;
        }

        textarea{
            height:80px;
        }

        .center{
            text-align:center;
        }

        footer{
            text-align:center;
            margin-top:15px;
        }
    </style>
